# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# API key for the local CyberWeb server.
# All /api/* endpoints require this key in the X-API-Key header.
# After setting this, paste the same value in Settings → Security → Server API Key
# so the frontend includes it in every request.
#
# Generate a strong random key, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CYBERWEB_API_KEY=

# Payload compiler: defaults to wsl on Windows, native on Linux/macOS.
# Install Metasploit separately. This is host configuration, never API input.
# For Windows with Kali WSL:
# CYBERWEB_MSF_MODE=wsl
# CYBERWEB_MSF_DISTRO=kali-linux
# CYBERWEB_MSF_PATH=/usr/bin/msfvenom
# For native Linux, set CYBERWEB_MSF_MODE=native and optionally a full executable path.

